#include <windows.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/packaging/TaskbarMonitor.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Taskbar Monitor Project"
   VALUE "FileDescription", "Taskbar Monitor"
   VALUE "FileVersion", "@PROJECT_VERSION@"
   VALUE "OriginalFilename", "TaskbarMonitor.exe"
   VALUE "ProductName", "Taskbar Monitor"
   VALUE "ProductVersion", "@PROJECT_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
